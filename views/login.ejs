<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hi | Login </title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  

  <div class="w-full h-screen bg-zinc-900 p-10 ">
    <h1 class="text-3xl tracking-tighter mb-3 text-white">Login User</h1>
    <form action="/login" method="post">
      <input class="px-5 border-2 text-white rounded-lg border-zinc-800 py-2 outline-none bg-transparent"  type="email" placeholder="email" name="email">
      <input class="px-5 border-2 text-white rounded-lg border-zinc-800 py-2 outline-none bg-transparent"  type="password" placeholder="password" name="password">
      <input type="submit" value="Login" class="text-white px-5 py-2 bg-blue-500 rounded-lg ml-3">
    </form>


  </div>
</body>
</html>